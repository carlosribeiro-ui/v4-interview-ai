# ─── Obrigatórias ───

# Chave HMAC pra assinar sessões (mín 32 chars). Gere com: openssl rand -hex 32
SESSION_SECRET=

# MongoDB Atlas (formato: mongodb+srv://user:pass@cluster.mongodb.net/dbname)
MONGODB_URI=

# Chave de API Gemini (Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# ─── Cloudflare R2 (Storage de vídeos, CVs, TTS) ───

R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ─── API Externa (n8n, Pipefy) ───

# Chave pra /api/integracoes/* via header x-api-key. Gere: openssl rand -hex 32
EXTERNAL_API_KEY=

# ─── Seeds (usuários iniciais) ───

# Senhas iniciais do admin e talent. Se omitidas, senhas aleatórias são geradas.
SEED_ADMIN_SENHA=
SEED_TALENT_SENHA=

# ─── Upstash Redis (rate limiting cross-instance) ───

# Free tier: 10k comandos/dia (https://upstash.com)
# Se não configurado, rate limiting usa in-memory (funciona por instância).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Sentry (opcional, erros em produção) ───

SENTRY_DSN=
