# Chave de API (unica: Gemini 2.5 Flash / Google)
# Obter chave em:
# - Google AI Studio: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=

# Chave para sistemas externos (n8n, Pipefy etc.) chamarem /api/integracoes/*
# via header x-api-key. Gere um valor aleatorio proprio, ex: openssl rand -hex 32
# Se ficar vazia, as rotas de integracao respondem 500 (recusam funcionar sem chave).
EXTERNAL_API_KEY=
